prefix=/usr/local
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libannocheck
Description: library for checking the security hardening status of binaries
Version: 13.02
URL: https://sourceware.org/annobin/

Libs: -L${libdir} -lannocheck
Cflags: -I${includedir}
